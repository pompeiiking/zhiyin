# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/
.eggs/

# ---- 虚拟环境 ----
.venv/
venv/
env/
ENV/

# ---- 测试与类型检查缓存 ----
.pytest_cache/
.pytest-*/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- 本地运行产物（第一期动态资源与对象存储的默认目录）----
# data/registry 与 data/knowledge 里是**需要入库演示的种子数据**，
# 必须提交；但运行时生成的对象与缓存不入库。
data/objects/
data/cache/
data/logs/
zhiyin-src/template/data/objects/
zhiyin-src/template/data/cache/
zhiyin-src/template/data/logs/
*.log
*.sqlite3
*.db

# ---- 前端 ----
node_modules/
dist-ssr/
*.local
.vite/

# ---- 编辑器与系统 ----
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- Git worktrees ----
.worktrees/

# ---- 敏感配置 ----
# 只提交 .env.example；真实密钥、Token、数据库口令一律不入库。
.env
.env.*
!.env.example
*.pem
*.key

# ---- Embedded Wanwu runtime state ----
platform/wanwu/.env
platform/wanwu/.env.*
platform/wanwu/.cache/
platform/wanwu/output/
platform/wanwu/runtime/
deploy/runtime/
zhiyin-src/template/deploy/runtime/
platform/wanwu/**/*.log
platform/wanwu/**/*.pid
zhiyin-src/template/deploy/.env

# These upstream files are required by the Wanwu frontend build despite
# repository-wide generated-file and environment-file ignore rules.
!platform/wanwu/web/
!platform/wanwu/web/.env.development
!platform/wanwu/web/.env.production
!platform/wanwu/web/build/
platform/wanwu/web/build/*
!platform/wanwu/web/build/version-plugin.js
!platform/wanwu/project/
platform/wanwu/project/*
!platform/wanwu/project/blank
