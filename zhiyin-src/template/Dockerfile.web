FROM node:22-bookworm-slim AS build

WORKDIR /app
COPY zhiyin-web/package.json zhiyin-web/package-lock.json ./
RUN npm ci
COPY zhiyin-web/ ./
RUN npm run build

FROM nginx:1.27-alpine

COPY zhiyin-web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=12 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/ || exit 1

