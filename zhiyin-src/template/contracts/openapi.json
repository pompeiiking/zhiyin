            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Send Message",
        "tags": [
          "conversation"
        ]
      }
    },
    "/api/v1/app/report/full-text": {
      "get": {
        "description": "完整报告页正文。只读资产版本，不重新生成。",
        "operationId": "get_report_full_text_api_v1_app_report_full_text_get",
        "parameters": [
          {
            "in": "query",
            "name": "version",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
