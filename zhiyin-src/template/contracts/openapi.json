  "info": {
    "title": "职引 API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/app/assets/export": {
      "post": {
        "description": "导出资产。第一期仅预留入口，available 恒 False。",
        "operationId": "export_asset_api_v1_app_assets_export_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse_ExportResultView_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Export Asset",
        "tags": [
          "asset"
        ]
      }
    },
    "/api/v1/app/assets/{asset_type}/versions": {
      "get": {
        "description": "资产历史版本列表，含 depends_on 与 diff。",
        "operationId": "list_asset_versions_api_v1_app_assets__asset_type__versions_get",
        "parameters": [
          {
            "in": "path",
            "name": "asset_type",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/AssetType"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse_list_AssetVersionView__"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "List Asset Versions",
        "tags": [
          "asset"
        ]
      }
    },
    "/api/v1/app/bootstrap": {
      "get": {
        "description": "启动装配：菜单 / 路由 / 任务入口 / 文案 / 功能开关。\n\n前端启动只请求一次即可渲染首页。",
        "operationId": "bootstrap_api_v1_app_bootstrap_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse_BootstrapView_"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Bootstrap",
        "tags": [
          "app"
        ]
      }
    },
    "/api/v1/app/conversation/message": {
      "post": {
        "description": "发送一轮消息，返回最短结论 + 显式告知 + 行为引导 + 管线卡。",
        "operationId": "send_message_api_v1_app_conversation_message_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse_ConversationTurnView_"
