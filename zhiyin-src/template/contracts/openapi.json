    "/api/v1/app/workspace": {
      "get": {
        "description": "工作台聚合视图：画像 / 报告 / 方案 / 计划 / 跟踪 + 功能块。\n\n进入工作台属于持久化行为，游客在此处被登录拦截（PRD §5.3）。",
        "operationId": "get_workspace_api_v1_app_workspace_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse_WorkspacePageView_"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Workspace",
        "tags": [
          "workspace"
        ]
      }
    },
    "/healthz": {
      "get": {
        "operationId": "healthz_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Healthz Healthz Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "装配健康检查",
        "tags": [
          "ops"
        ]
      }
    }
  }
