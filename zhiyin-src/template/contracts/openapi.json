        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiResponse_ReportFullTextView_"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Report Full Text",
        "tags": [
          "asset"
        ]
      }
    },
    "/api/v1/app/sessions": {
      "get": {
        "description": "左栏会话列表（并行任务会话，按任务/环节命名）。",
