{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    // 被 references 引用的 composite 项目不能关掉 emit（TS6310），
    // 否则 `npm run typecheck` 直接失败。把产物丢进被忽略的 node_modules/.tmp，
    // 既满足 composite 的约束，也不会在仓库里留下构建垃圾。
    "outDir": "./node_modules/.tmp/tsconfig.node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}
