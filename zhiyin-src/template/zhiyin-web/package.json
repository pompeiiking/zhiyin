{
  "name": "zhiyin-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "职引 · 前端（Vue 3 + Vite + TypeScript）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "gen:api": "openapi-typescript http://localhost:8000/api/v1/openapi.json -o src/api/types.ts"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.3.0",
    "pinia": "^2.1.0",
    "axios": "^1.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vue-tsc": "^2.0.0",
    "openapi-typescript": "^6.7.0"
  }
}
